{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fleet": "Data Source=fleet.db"
  },
  "Tracking": {
    "MovingSpeedThresholdKph": 5,
    "StationaryTripEnd": "00:05:00",
    "MaxPingGap": "00:10:00",
    "IdleAlertAfter": "00:03:00",
    "OverspeedHysteresisKph": 5
  },
  "Simulator": {
    "Enabled": false,
    "Interval": "00:00:02"
  },
  "Ingestion": {
    "DeviceApiKey": ""
  },
  "Cors": {
    "Origins": [ "http://localhost:4200" ]
  }
}
